// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String             @id @default(cuid())
  name            String?
  email           String?            @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  accounts        Account[]
  sessions        Session[]
  clients         Client[]
  invoices        Invoice[]
  quotes          Quote[]
  projects        Project[]
  expenses        Expense[]
  recurring       RecurringInvoice[]
  settings        Setting[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  invoiceTemplate InvoiceTemplate?
  pipelines       Pipeline[]
  deals           Deal[]
  createdAt       DateTime           @default(now())

  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                String             @id @default(cuid())
  name              String
  email             String
  address           String?
  phone             String?
  vatNumber         String?
  photo             String?
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  quotes            Quote[]
  projects          Project[]
  recurringInvoices RecurringInvoice[]
  deals             Deal[]
  signatures        DocumentSignature[]
  leadScore         Int                @default(0)
  lastContact       DateTime?
  totalDealValue    Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  portalToken       String?            @unique

  @@unique([userId, email])
}

model Invoice {
  id             String          @id @default(cuid())
  number         String
  date           DateTime
  dueDate        DateTime
  status         String          @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED, PARTIAL
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  subtotal       Float           @default(0)
  taxTotal       Float           @default(0)
  total          Float
  amountPaid     Float           @default(0)
  payments       Payment[]
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  dealId         String?
  deal           Deal?           @relation(fields: [dealId], references: [id])
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  escrowContract EscrowContract?

  @@unique([userId, number])
}

model EscrowContract {
  id         String   @id @default(cuid())
  invoiceId  String   @unique
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  platform   String // e.g., "FIGMA", "GITHUB"
  resourceId String // URL or ID of the resource to check
  condition  String // e.g., "APPROVED", "MERGED"
  status     String   @default("PENDING") // PENDING, RELEASED, CANCELLED
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Quote {
  id         String      @id @default(cuid())
  number     String
  date       DateTime
  expiryDate DateTime
  status     String      @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      QuoteItem[]
  subtotal   Float       @default(0)
  taxTotal   Float       @default(0)
  total      Float
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id])
  dealId     String?
  deal       Deal?       @relation(fields: [dealId], references: [id])
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, number])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float  @default(0)
  taxAmount   Float  @default(0)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  method    String   @default("E-TRANSFER") // CASH, CHEQUE, E-TRANSFER, CREDIT_CARD, OTHER
  notes     String?
  createdAt DateTime @default(now())
}

model RecurringInvoice {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             String // JSON string of items
  frequency         String // WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextRunDate       DateTime
  maxOccurrences    Int? // NULL means infinite
  currentOccurrence Int      @default(0)
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Setting {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName          String
  companyEmail         String
  companyAddress       String?
  companyPhone         String?
  companyLogo          String?
  companyWebsite       String?
  companyTaxId         String?
  paymentInstructions  String?
  currency             String   @default("USD")
  defaultTaxRate       Float    @default(13)
  invoiceTemplate      String   @default("modern")
  quoteTemplate        String   @default("modern")
  resendApiKey         String?
  stripePublishableKey String?
  stripeSecretKey      String?
  cryptoWalletAddress  String?
  agentApiKey          String?  @unique
  localAiUrl           String   @default("http://localhost:11434/v1")
  localAiModel         String   @default("llama3")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String // INFO, WARNING, SUCCESS, ERROR
  title     String
  message   String?
  read      Boolean  @default(false)
  date      DateTime @default(now())
  link      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  category    String
  receipt     String? // Base64 data URI
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  quotes      Quote[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0f172a") // Default slate-900
  font      String   @default("inter")
  layout    String   @default("modern")
  logoUrl   String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

// Pipeline CRM Models
model Pipeline {
  id          String          @id @default(cuid())
  name        String
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages      PipelineStage[]
  deals       Deal[]
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, name])
}

model PipelineStage {
  id          String    @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  color       String    @default("#3b82f6")
  order       Int
  probability Float     @default(0)
  deals       Deal[]
  createdAt   DateTime  @default(now())

  @@unique([pipelineId, order])
}

model Deal {
  id            String        @id @default(cuid())
  title         String
  description   String?
  value         Float
  currency      String        @default("USD")
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String        @default("OPEN") // OPEN, WON, LOST, STALE
  source        String?
  priority      String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  expectedClose DateTime?
  activities    DealActivity[]
  notes         DealNote[]
  quotes        Quote[]
  invoices      Invoice[]
  customFields  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DealActivity {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type        String   // CALL, EMAIL, MEETING, NOTE, STAGE_CHANGE, QUOTE_SENT, INVOICE_SENT
  description String
  metadata    String?
  createdBy   String
  createdAt   DateTime @default(now())
}

model DealNote {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  content   String
  isPinned  Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// E-Signature model for document signing
model DocumentSignature {
  id            String   @id @default(cuid())
  documentId    String
  documentType  String   // INVOICE, QUOTE, CONTRACT
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  signatureData String   // base64 SVG/PNG
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  documentHash  String   // SHA256 of document at signing
  metadata      String?  // JSON: {name, title, company}
}

// SOC2 Audit Log — records all significant data operations
model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATE, UPDATE, DELETE, VIEW, EXPORT, SETTINGS_CHANGE, DATA_PURGE
  resource   String // Invoice, Client, Quote, Payment, Settings, etc.
  resourceId String? // ID of the affected record
  actor      String   @default("system") // "system" or user identifier
  ipAddress  String?
  metadata   String? // JSON string with additional context
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
