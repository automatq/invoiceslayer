generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Team {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  logo         String?
  settings     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  clients      Client[]
  deals        Deal[]
  expenses     Expense[]
  invitations  Invitation[]
  invoices     Invoice[]
  pipelines    Pipeline[]
  projects     Project[]
  quotes       Quote[]
  recurring    RecurringInvoice[]
  settingsTeam    Setting[]
  members         TeamMember[]
  profitBuckets   ProfitBucket[]
  expenseBudgets  ExpenseBudget[]
  financialGoals  FinancialGoal[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      UserRole @default(VIEWER)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Invitation {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      UserRole @default(VIEWER)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  accepted  Boolean  @default(false)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
}

model User {
  id              String             @id @default(cuid())
  name            String?
  email           String?            @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  accounts        Account[]
  auditLogs       AuditLog[]
  clients         Client[]
  deals           Deal[]
  expenses        Expense[]
  invoices        Invoice[]
  invoiceTemplate InvoiceTemplate?
  notifications   Notification[]
  pipelines       Pipeline[]
  projects        Project[]
  quotes          Quote[]
  recurring       RecurringInvoice[]
  sessions        Session[]
  settings        Setting?
  teams           TeamMember[]
  profitBuckets   ProfitBucket[]
  expenseBudgets  ExpenseBudget[]
  financialGoals  FinancialGoal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                String              @id @default(cuid())
  name              String
  email             String
  address           String?
  phone             String?
  vatNumber         String?
  photo             String?
  userId            String
  teamId            String?
  leadScore         Int                 @default(0)
  lastContact       DateTime?
  totalDealValue    Float               @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  portalToken       String?             @unique
  team              Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals             Deal[]
  signatures        DocumentSignature[]
  invoices          Invoice[]
  projects          Project[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]

  @@unique([userId, email])
  @@index([teamId])
}

model Invoice {
  id             String          @id @default(cuid())
  number         String
  date           DateTime
  dueDate        DateTime
  status         String          @default("DRAFT")
  clientId       String
  userId         String
  teamId         String?
  subtotal       Float           @default(0)
  taxTotal       Float           @default(0)
  total          Float
  amountPaid     Float           @default(0)
  projectId      String?
  dealId         String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  escrowContract EscrowContract?
  deal           Deal?           @relation(fields: [dealId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([userId, number])
  @@index([teamId])
}

model EscrowContract {
  id         String   @id @default(cuid())
  invoiceId  String   @unique
  platform   String
  resourceId String
  condition  String
  status     String   @default("PENDING")
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Quote {
  id         String      @id @default(cuid())
  number     String
  date       DateTime
  expiryDate DateTime
  status     String      @default("DRAFT")
  clientId   String
  userId     String
  teamId     String?
  subtotal   Float       @default(0)
  taxTotal   Float       @default(0)
  total      Float
  projectId  String?
  dealId     String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deal       Deal?       @relation(fields: [dealId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId], references: [id])
  items      QuoteItem[]

  @@unique([userId, number])
  @@index([teamId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float  @default(0)
  taxAmount   Float  @default(0)
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  date      DateTime @default(now())
  method    String   @default("E-TRANSFER")
  notes     String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model RecurringInvoice {
  id                String   @id @default(cuid())
  clientId          String
  userId            String
  teamId            String?
  items             String
  frequency         String
  nextRunDate       DateTime
  maxOccurrences    Int?
  currentOccurrence Int      @default(0)
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client   @relation(fields: [clientId], references: [id])

  @@index([teamId])
}

model Setting {
  id                   String   @id @default(cuid())
  userId               String   @unique
  teamId               String?
  companyName          String
  companyEmail         String
  companyAddress       String?
  companyPhone         String?
  companyLogo          String?
  companyWebsite       String?
  companyTaxId         String?
  paymentInstructions  String?
  currency             String   @default("USD")
  defaultTaxRate       Float    @default(13)
  invoiceTemplate      String   @default("modern")
  quoteTemplate        String   @default("modern")
  resendApiKey         String?
  stripePublishableKey String?
  stripeSecretKey      String?
  cryptoWalletAddress  String?
  agentApiKey          String?  @unique
  localAiUrl           String   @default("http://localhost:11434/v1")
  localAiModel         String   @default("llama3")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  team                 Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String?
  read      Boolean  @default(false)
  date      DateTime @default(now())
  link      String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  category    String
  receipt     String?
  projectId   String?
  userId      String
  teamId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([teamId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE")
  clientId    String
  userId      String
  teamId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]
  invoices    Invoice[]
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id])
  quotes      Quote[]

  @@index([teamId])
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  color     String   @default("#0f172a")
  font      String   @default("inter")
  layout    String   @default("modern")
  logoUrl   String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pipeline {
  id        String          @id @default(cuid())
  name      String
  userId    String
  teamId    String?
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deals     Deal[]
  team      Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@unique([userId, name])
  @@index([teamId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  color       String   @default("#3b82f6")
  order       Int
  probability Float    @default(0)
  createdAt   DateTime @default(now())
  deals       Deal[]
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, order])
}

model Deal {
  id            String         @id @default(cuid())
  title         String
  description   String?
  value         Float
  currency      String         @default("USD")
  pipelineId    String
  stageId       String
  clientId      String
  userId        String
  teamId        String?
  status        String         @default("OPEN")
  source        String?
  priority      String         @default("MEDIUM")
  expectedClose DateTime?
  customFields  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id])
  stage         PipelineStage  @relation(fields: [stageId], references: [id])
  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  activities    DealActivity[]
  notes         DealNote[]
  invoices      Invoice[]
  quotes        Quote[]

  @@index([teamId])
}

model DealActivity {
  id          String   @id @default(cuid())
  dealId      String
  type        String
  description String
  metadata    String?
  createdBy   String
  createdAt   DateTime @default(now())
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model DealNote {
  id        String   @id @default(cuid())
  dealId    String
  content   String
  isPinned  Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model DocumentSignature {
  id            String   @id @default(cuid())
  documentId    String
  documentType  String
  clientId      String
  signatureData String
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  documentHash  String
  metadata      String?
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  actor      String   @default("system")
  ipAddress  String?
  metadata   String?
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES
  VIEWER
}

model ProfitBucket {
  id          String   @id @default(cuid())
  name        String
  percentage  Float
  description String?
  userId      String
  teamId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model ExpenseBudget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  period    String   @default("MONTHLY")
  userId    String
  teamId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, period])
  @@index([teamId])
}

model FinancialGoal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  type         String   @default("REVENUE") // REVENUE or PROFIT
  startDate    DateTime
  endDate      DateTime
  userId       String
  teamId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
