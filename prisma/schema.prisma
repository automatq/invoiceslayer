// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  address           String?
  phone             String?
  vatNumber         String?
  photo             String?
  invoices          Invoice[]
  quotes            Quote[]
  projects          Project[]
  recurringInvoices RecurringInvoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  portalToken       String?            @unique
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  date       DateTime
  dueDate    DateTime
  status     String        @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED, PARTIAL
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  items      InvoiceItem[]
  subtotal   Float         @default(0)
  taxTotal   Float         @default(0)
  total      Float
  amountPaid Float         @default(0)
  payments   Payment[]
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  escrowContract EscrowContract?
}

model EscrowContract {
  id          String   @id @default(cuid())
  invoiceId   String   @unique
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  platform    String   // e.g., "FIGMA", "GITHUB"
  resourceId  String   // URL or ID of the resource to check
  condition   String   // e.g., "APPROVED", "MERGED"
  status      String   @default("PENDING") // PENDING, RELEASED, CANCELLED
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  date       DateTime
  expiryDate DateTime
  status     String      @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  items      QuoteItem[]
  subtotal   Float       @default(0)
  taxTotal   Float       @default(0)
  total      Float
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float  @default(0)
  taxAmount   Float  @default(0)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  method    String   @default("E-TRANSFER") // CASH, CHEQUE, E-TRANSFER, CREDIT_CARD, OTHER
  notes     String?
  createdAt DateTime @default(now())
}

model RecurringInvoice {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  items             String   // JSON string of items
  frequency         String   // WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextRunDate       DateTime
  maxOccurrences    Int?     // NULL means infinite
  currentOccurrence Int      @default(0)
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Setting {
  id             String   @id @default(cuid())
  companyName    String
  companyEmail   String
  companyAddress String?
  companyPhone   String?
  companyLogo    String?
  companyWebsite String?
  companyTaxId   String?
  paymentInstructions String?
  currency       String   @default("USD")
  defaultTaxRate Float    @default(13)
  invoiceTemplate String   @default("modern")
  quoteTemplate   String   @default("modern")
  resendApiKey    String?
  stripePublishableKey String?
  stripeSecretKey String?
  cryptoWalletAddress String?
  agentApiKey    String?  @unique
  localAiUrl     String   @default("http://localhost:11434/v1")
  localAiModel   String   @default("llama3")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // INFO, WARNING, SUCCESS, ERROR
  title     String
  message   String?
  read      Boolean  @default(false)
  date      DateTime @default(now())
  link      String?
  userId    String?  // Optional relation to User if needed later
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  category    String
  receipt     String? // Base64 data URI
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  invoices    Invoice[]
  quotes      Quote[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0f172a") // Default slate-900
  font      String   @default("inter")
  layout    String   @default("modern")
  logoUrl   String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
