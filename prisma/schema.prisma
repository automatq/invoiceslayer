// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  address           String?
  phone             String?
  vatNumber         String?
  photo             String?
  invoices          Invoice[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  date       DateTime
  dueDate    DateTime
  status     String        @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED, PARTIAL
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  items      InvoiceItem[]
  subtotal   Float         @default(0)
  taxTotal   Float         @default(0)
  total      Float
  amountPaid Float         @default(0)
  payments   Payment[]
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  date       DateTime
  expiryDate DateTime
  status     String      @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  items      QuoteItem[]
  subtotal   Float       @default(0)
  taxTotal   Float       @default(0)
  total      Float
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  taxRate     Float  @default(0)
  taxAmount   Float  @default(0)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  method    String   @default("E-TRANSFER") // CASH, CHEQUE, E-TRANSFER, CREDIT_CARD, OTHER
  notes     String?
  createdAt DateTime @default(now())
}

model RecurringInvoice {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  items       String   // JSON string of items
  frequency   String   // WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextRunDate DateTime
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id             String   @id @default(cuid())
  companyName    String
  companyEmail   String
  companyAddress String?
  companyPhone   String?
  companyLogo    String?
  currency       String   @default("USD")
  defaultTaxRate Float    @default(13)
  invoiceTemplate String   @default("modern")
  quoteTemplate   String   @default("modern")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
